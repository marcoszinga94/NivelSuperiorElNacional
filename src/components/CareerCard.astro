---
/**
 * Ficha compartida por las dos carreras de la home: mismo estilo y mismo tipo
 * de información para Desarrollo de Software y Administración.
 */
interface Props {
  /** Nombre de la carrera, ej. "Desarrollo de Software". */
  name: string;
  description: string;
  /** Duración en formato corto, ej. "3" o "2½". */
  duration: string;
  durationUnit?: string;
}

const { name, description, duration, durationUnit = "años" } = Astro.props;

const chips = [
  ["📍", "La Carlota, Córdoba"],
  ["🎓", "Título oficial"],
  ["💼", "Práctica desde 2° año"],
  ["🏫", "Escuela Superior El Nacional"],
];
---

<div class="reveal grid gap-8 rounded-[20px] border border-ba bg-bg3 p-8 md:p-10 lg:grid-cols-[1fr_auto] lg:items-center">
  <div>
    <div class="mb-3 font-mono text-[10px] uppercase tracking-[0.16em] text-a1/75">
      Título oficial · Escuela Superior El Nacional
    </div>
    <div class="mb-4 text-[clamp(20px,2.6vw,28px)] font-bold leading-tight text-t1">
      Técnico Superior en<br />{name}
    </div>
    <p class="mb-5 max-w-[560px] text-[13.5px] font-light leading-[1.75] text-t2">{description}</p>

    <div class="flex flex-wrap gap-2">
      {
        chips.map(([icon, label]) => (
          <span class="inline-flex items-center gap-2 rounded-full border border-line1 bg-bg4 px-3.5 py-1.5 text-[12px] text-t2">
            <span>{icon}</span>
            {label}
          </span>
        ))
      }
    </div>

    <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2">
      <a
        href="/#inscripcion"
        class="inline-flex items-center gap-2 rounded-[10px] border border-a1/30 bg-a1/15 px-5 py-2.5 text-[13px] font-semibold text-a1 transition duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:bg-a1/25 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-a1"
      >
        Consultá por la carrera →
      </a>
      <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-t3">
        Inscripciones abiertas · 2027
      </span>
    </div>
  </div>

  <div class="flex gap-4">
    <div class="rounded-2xl border border-line1 bg-bg4 px-6 py-5 text-center">
      <div class="font-mono text-3xl font-medium text-t1">
        {duration}<span class="ml-1 text-sm text-t3">{durationUnit}</span>
      </div>
      <div class="mt-1 text-[10px] uppercase tracking-[0.08em] text-t3">Duración</div>
    </div>
    <div class="rounded-2xl border border-line1 bg-bg4 px-6 py-5 text-center">
      <div class="font-mono text-3xl font-medium text-t1">100<span class="text-sm text-t3">%</span></div>
      <div class="mt-1 text-[10px] uppercase tracking-[0.08em] text-t3">Presencial</div>
    </div>
  </div>
</div>
