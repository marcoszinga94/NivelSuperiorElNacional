---
import { routeGroups } from "../data/routes";
---

<div class="mx-auto max-w-[1120px] px-5 py-16 md:px-10">
  <div class="reveal mb-10 flex flex-col gap-2">
    <div class="inline-flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.2em] text-a1/75">
      <span class="h-px w-5 bg-a1/50"></span>
      Mapa del sitio
    </div>
    <h2 class="text-[clamp(22px,3vw,32px)] font-bold tracking-[-0.02em] text-t1">Elegí por dónde empezar</h2>
    <p class="max-w-[560px] text-[14px] font-light text-t2">
      Dividimos todo en páginas cortas, agrupadas en tres secciones. Entrá a la que te interese.
    </p>
  </div>

  <div class="flex flex-col gap-10">
    {
      routeGroups.map((g) => (
        <div class="flex flex-col gap-3">
          <div class="flex items-center gap-2.5">
            <span class="flex h-8 w-8 items-center justify-center rounded-lg border border-line1 bg-bg3 text-base">
              {g.icon}
            </span>
            <span class="text-[15px] font-semibold text-t1">{g.label}</span>
            <span class="h-px flex-1 bg-line1" />
          </div>

          <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {g.routes.map((r, i) => (
              <a
                href={r.href}
                class:list={["reveal", `reveal-d${(i % 6) + 1}`, "group flex items-center gap-4 rounded-xl border border-line1 bg-bg3 p-5 transition hover:-translate-y-0.5 hover:border-a1/40 hover:bg-bg4"]}
              >
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-[10px] border border-line1 bg-bg4 text-xl">
                  {r.icon}
                </span>
                <span class="min-w-0">
                  <span class="block text-[14px] font-semibold text-t1">{r.label}</span>
                  <span class="block text-[12px] leading-snug text-t3">{r.blurb}</span>
                </span>
                <span class="ml-auto text-a1/60 transition-transform group-hover:translate-x-0.5">→</span>
              </a>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</div>
