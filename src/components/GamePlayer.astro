---
/**
 * Embeds a recovered pygame game (pygbag build) served from
 * `public/jugar/<slug>/juego/`. The game keeps its own document so the
 * fullscreen button hands the whole screen to the emulator, not the page.
 */
interface Props {
  /** Folder under `public/jugar/` holding the build. */
  slug: string;
  title: string;
  /** Card gradient reused behind the frame while the engine downloads. */
  gradient?: string;
}

const { slug, title, gradient } = Astro.props;
const frameSrc = `/jugar/${slug}/juego/index.html`;
---

<div class="game-player reveal flex flex-col" data-player>
  <div class="order-2 my-2 flex items-center justify-between gap-3 rounded-lg border border-a1/25 bg-a1/10 px-3 py-2 lg:hidden">
    <span class="text-[11px] leading-snug text-t2">📱 Mejor a pantalla completa</span>
    <button
      type="button"
      data-player-fullscreen
      aria-pressed="false"
      class="inline-flex shrink-0 items-center gap-1.5 rounded-md border border-a1/35 bg-a1/15 px-2.5 py-1.5 text-[11px] font-semibold text-a1 transition hover:bg-a1/25 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-a1"
    >
      <span aria-hidden="true">⛶</span> Pantalla completa
    </button>
  </div>

  <div
    class="game-stage relative order-1 aspect-video w-full overflow-hidden rounded-xl bg-bg4"
    style={gradient ? `background:${gradient}` : undefined}
    data-player-stage
  >
    <iframe
      src={frameSrc}
      title={`Jugar a ${title} en el navegador`}
      class="relative z-[1] h-full w-full border-0 bg-black"
      loading="lazy"
      allow="autoplay; fullscreen; gamepad"
      data-player-frame
    ></iframe>

    <button
      type="button"
      data-player-fullscreen
      class="absolute right-2.5 top-2.5 z-[2] inline-flex h-10 w-10 items-center justify-center rounded-lg border border-white/15 bg-black/55 text-lg text-white/90 backdrop-blur transition hover:bg-black/75 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-a1"
      aria-label="Pantalla completa"
      title="Pantalla completa"
    >
      <span aria-hidden="true">⛶</span>
    </button>
  </div>

  <div class="order-3 mt-3 flex flex-wrap items-center gap-2">
    <button
      type="button"
      data-player-fullscreen
      aria-pressed="false"
      class="inline-flex items-center gap-2 rounded-lg border border-line1 bg-bg3 px-3.5 py-2 text-sm font-semibold text-t1 transition duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:border-a1/40 hover:bg-bg4 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-a1"
    >
      <span aria-hidden="true">⛶</span>
      <span data-player-fullscreen-label>Pantalla completa</span>
    </button>
    <button
      type="button"
      data-player-reload
      class="inline-flex items-center gap-2 rounded-lg border border-line1 bg-bg3 px-3.5 py-2 text-sm font-semibold text-t1 transition duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:border-a1/40 hover:bg-bg4 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-a1"
    >
      <span aria-hidden="true">⟲</span> Reiniciar
    </button>
    <a
      href={frameSrc}
      target="_blank"
      rel="noopener"
      class="inline-flex items-center gap-2 rounded-lg border border-line1 bg-bg3 px-3.5 py-2 text-sm font-semibold text-t1 transition duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:border-a1/40 hover:bg-bg4 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-a1"
    >
      <span aria-hidden="true">↗</span> Abrir aparte
    </a>
    <p class="ml-auto hidden font-mono text-[10px] uppercase tracking-[0.14em] text-t3 lg:block">
      Esc para salir de pantalla completa
    </p>
  </div>

  <p class="order-4 mt-2 text-[11px] leading-relaxed text-t3 lg:hidden">
    📱 En el celular el juego se mantiene apaisado, también en vertical. Abrí
    <span class="font-medium text-t2">🎮</span> para moverte y <span class="font-medium text-t2">⌨</span>
    para escribir; para más comodidad, girate y tocá
    <span class="font-medium text-t2">Pantalla completa</span>.
  </p>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-player]").forEach((player) => {
    const frame = player.querySelector<HTMLIFrameElement>("[data-player-frame]");
    const stage = player.querySelector<HTMLElement>("[data-player-stage]");
    const fullscreenButtons = player.querySelectorAll<HTMLButtonElement>("[data-player-fullscreen]");
    const fullscreenLabels = player.querySelectorAll<HTMLElement>("[data-player-fullscreen-label]");

    const isFullscreen = () => Boolean(stage && document.fullscreenElement === stage);

    const syncFullscreen = () => {
      const on = isFullscreen();
      fullscreenButtons.forEach((button) => button.setAttribute("aria-pressed", String(on)));
      fullscreenLabels.forEach((label) => {
        label.textContent = on ? "Salir de pantalla completa" : "Pantalla completa";
      });
      if (!on) {
        try {
          void screen.orientation?.unlock?.();
        } catch {
          /* El navegador no permite bloquear la orientación. */
        }
      }
    };

    fullscreenButtons.forEach((button) => {
      button.addEventListener("click", async () => {
        if (!stage) return;

        if (isFullscreen()) {
          try {
            await document.exitFullscreen();
          } catch {
            /* Nada que hacer. */
          }
          return;
        }

        // iOS Safari no permite fullscreen sobre un div: abrimos el build solo.
        if (!stage.requestFullscreen) {
          window.open(frame?.src ?? "", "_blank", "noopener");
          return;
        }

        try {
          await stage.requestFullscreen({ navigationUI: "hide" });
          // Solo en pantallas táctiles: en un monitor de escritorio no queremos
          // rotar la pantalla del usuario.
          if (window.matchMedia("(pointer: coarse)").matches || navigator.maxTouchPoints > 0) {
            try {
              await screen.orientation?.lock?.("landscape");
            } catch {
              /* En retrato el juego sigue andando, solo avisamos con el texto. */
            }
          }
        } catch {
          /* El navegador puede rechazar fullscreen; queda el botón "Abrir aparte". */
        }
      });
    });

    document.addEventListener("fullscreenchange", syncFullscreen);
    syncFullscreen();

    player.querySelector("[data-player-reload]")?.addEventListener("click", () => {
      if (!frame) return;
      // Re-assigning src restarts the emulator without touching the host page.
      frame.src = frame.src;
    });
  });
</script>
