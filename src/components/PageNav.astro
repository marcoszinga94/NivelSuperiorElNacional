---
import { neighbours } from "../data/routes";

interface Props {
  href: string;
}

const { href } = Astro.props;
const { prev, next } = neighbours(href);
---

<div class="mx-auto max-w-[1120px] px-5 pb-16 md:px-10">
  <div class="flex flex-wrap items-stretch justify-between gap-3 border-t border-line1 pt-8">
    {
      prev ? (
        <a
          href={prev.href}
          class="group flex items-center gap-3 rounded-xl border border-line1 bg-bg3 px-5 py-4 transition hover:border-a1/40"
        >
          <span class="text-a1/60 transition-transform group-hover:-translate-x-0.5">←</span>
          <span>
            <span class="block font-mono text-[9px] uppercase tracking-[0.14em] text-t3">Anterior</span>
            <span class="block text-[13px] font-semibold text-t1">
              {prev.icon} {prev.label}
            </span>
          </span>
        </a>
      ) : (
        <span />
      )
    }
    {
      next ? (
        <a
          href={next.href}
          class="group ml-auto flex items-center gap-3 rounded-xl border border-line1 bg-bg3 px-5 py-4 text-right transition hover:border-a1/40"
        >
          <span>
            <span class="block font-mono text-[9px] uppercase tracking-[0.14em] text-t3">Siguiente</span>
            <span class="block text-[13px] font-semibold text-t1">
              {next.label} {next.icon}
            </span>
          </span>
          <span class="text-a1/60 transition-transform group-hover:translate-x-0.5">→</span>
        </a>
      ) : (
        <span />
      )
    }
  </div>
</div>
