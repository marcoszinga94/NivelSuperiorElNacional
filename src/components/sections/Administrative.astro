---
import Section from "../Section.astro";
import SectionHeader from "../SectionHeader.astro";
---

<Section id="administrativas" bg="bg2">
  <SectionHeader
    eyebrow="Proyecto · Muestra Institucional 2026"
    sub="El segundo proyecto de la muestra: aplicaciones de gestión pensadas para el día a día de la escuela, desarrolladas por los estudiantes de la tecnicatura."
  >
    Desarrollo de aplicaciones <span class="text-gradient-2">administrativas</span>
  </SectionHeader>

  <div
    class="reveal flex flex-col items-start gap-4 rounded-xl border border-dashed border-line2 bg-bg3 p-7 sm:p-9"
  >
    <div class="inline-flex items-center gap-2 rounded-full border border-line2 px-3 py-1 font-mono text-[9px] uppercase tracking-[0.16em] text-a1">
      En preparación
    </div>
    <h3 class="text-[clamp(18px,2.2vw,24px)] font-semibold tracking-[-0.02em] text-t1">
      Todavía no publicamos el detalle de este proyecto
    </h3>
    <p class="max-w-[620px] text-[14px] font-light leading-[1.75] text-t2">
      Cuando esté, acá vas a encontrar qué problema resuelve, cómo se construye y quiénes participan. Las aplicaciones
      ya terminadas se van a listar en <a href="/aplicaciones" class="text-a1 hover:underline">Aplicaciones</a>.
    </p>
    <div class="mt-1 flex flex-wrap gap-2.5">
      <a
        href="/aplicaciones"
        class="rounded-[10px] bg-a1 px-5 py-2.5 text-[13px] font-semibold text-white transition  hover:opacity-90"
      >
        Ver las aplicaciones →
      </a>
      <a
        href="/proyecto"
        class="rounded-[10px] border border-line2 px-5 py-2.5 text-[13px] font-medium text-t1 transition hover:bg-line1"
      >
        Ver Astrónomos por un día
      </a>
    </div>
  </div>
</Section>
