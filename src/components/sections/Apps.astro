---
import Section from "../Section.astro";
import SectionHeader from "../SectionHeader.astro";
import { apps } from "../../data/apps";

// La primera captura hace de portada; el resto va a la galería.
const items = apps.map((app) => {
  const [cover, ...gallery] = app.screenshots ?? [];
  return { ...app, cover, gallery };
});
---

<Section id="aplicaciones" bg="bg">
  <SectionHeader
    eyebrow="Aplicaciones · 2026"
    sub="Las aplicaciones administrativas que salen del proyecto: software de gestión que resuelve problemas concretos de la escuela."
  >
    Aplicaciones <span class="text-gradient-2">en uso</span>
  </SectionHeader>

  {
    items.length > 0 ? (
      <div class="flex flex-col gap-8">
        {items.map((app, i) => (
          <article
            class:list={[
              "reveal reveal-seq",
              "overflow-hidden rounded-2xl border border-line1 bg-bg2",
            ]}
            style={`--reveal-i:${i}`}
          >
              <div class="grid lg:grid-cols-[1.2fr_0.8fr]">
                {app.cover ? (
                  <button
                    type="button"
                    data-lightbox
                    data-lightbox-group={app.slug}
                    data-lightbox-src={app.cover.src}
                    data-lightbox-caption={app.cover.caption}
                    data-lightbox-alt={app.cover.alt}
                    class="group relative flex aspect-[16/10] w-full cursor-zoom-in items-center justify-center overflow-hidden border-b border-line1 bg-bg3 p-2.5 lg:border-b-0 lg:border-r"
                    aria-label={`Ampliar captura: ${app.cover.caption}`}
                  >
                    <img
                      src={app.cover.src}
                      alt={app.cover.alt}
                      loading="eager"
                      decoding="async"
                      class="h-full w-full object-contain transition-transform duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:scale-[1.02]"
                    />
                    <span class="pointer-events-none absolute right-3 bottom-3 rounded-full border border-line1 bg-bg/85 px-3 py-1 font-mono text-[9px] uppercase tracking-[0.14em] text-t2 opacity-0 backdrop-blur transition group-hover:opacity-100">
                      Ampliar ↗
                    </span>
                  </button>
                ) : (
                  <div class="flex aspect-[16/10] items-center justify-center border-b border-line1 bg-bg3 text-6xl lg:border-b-0 lg:border-r">
                    {app.icon}
                  </div>
                )}

                <div class="flex flex-col gap-4 p-6 sm:p-7">
                  <div class="flex items-center gap-3">
                    <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-[10px] border border-line1 bg-bg4 text-xl">
                      {app.icon}
                    </span>
                    <span class="inline-flex items-center gap-1.5 rounded-full border border-a1/25 bg-a1/10 px-3 py-1 font-mono text-[9px] uppercase tracking-[0.14em] text-a1">
                      <span class="h-1.5 w-1.5 rounded-full bg-a1"></span>
                      {app.status}
                    </span>
                  </div>

                  <div>
                    <h3 class="text-[clamp(22px,2.4vw,28px)] font-bold leading-tight tracking-[-0.025em] text-t1">
                      {app.name}
                    </h3>
                    <p class="mt-2.5 text-[13.5px] font-light leading-[1.75] text-t2">{app.description}</p>
                  </div>

                  {app.authors && app.authors.length > 0 && (
                    <div>
                      <div class="font-mono text-[9px] uppercase tracking-[0.16em] text-t3">Desarrollada por</div>
                      <div class="mt-1 text-[13px] font-medium text-t1">{app.authors.join(" · ")}</div>
                    </div>
                  )}

                  {app.tech && app.tech.length > 0 && (
                    <div class="flex flex-wrap gap-1.5">
                      {app.tech.map((t) => (
                        <span class="rounded border border-line1 bg-bg5 px-2 py-0.5 font-mono text-[9px] text-t3">{t}</span>
                      ))}
                    </div>
                  )}

                  {app.href && (
                    <a
                      href={app.href}
                      target="_blank"
                      rel="noopener"
                      class="mt-auto inline-flex w-fit items-center gap-1.5 rounded-[10px] border border-a1/30 bg-a1/15 px-4 py-2 text-[12px] font-semibold text-a1 transition duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:bg-a1/25 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-a1"
                    >
                      Abrir la aplicación →
                    </a>
                  )}
                </div>
              </div>

              {app.gallery.length > 0 && (
                <div class="border-t border-line1 bg-bg p-4 sm:p-5">
                  <div class:list={["grid gap-3.5", app.gallery.length > 1 ? "sm:grid-cols-2 lg:grid-cols-3" : ""]}>
                    {app.gallery.map((shot) => (
                      <button
                        type="button"
                        data-lightbox
                        data-lightbox-group={app.slug}
                        data-lightbox-src={shot.src}
                        data-lightbox-caption={shot.caption}
                        data-lightbox-alt={shot.alt}
                        class="group block w-full cursor-zoom-in text-left"
                        aria-label={`Ampliar captura: ${shot.caption}`}
                      >
                        <div class="flex aspect-[16/10] items-center justify-center overflow-hidden rounded-lg border border-line1 bg-bg3 transition duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:border-a1/35">
                          <img
                            src={shot.src}
                            alt={shot.alt}
                            loading="lazy"
                            decoding="async"
                            class="h-full w-full object-contain transition-transform duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:scale-[1.02]"
                          />
                        </div>
                        <div class="mt-2 flex items-center justify-between gap-2">
                          <span class="text-[11px] font-medium text-t2">{shot.caption}</span>
                          <span class="font-mono text-[9px] uppercase tracking-[0.12em] text-t3 transition group-hover:text-a1">
                            Ampliar ↗
                          </span>
                        </div>
                      </button>
                    ))}
                  </div>
                </div>
              )}
          </article>
        ))}
      </div>
    ) : (
      <div class="reveal flex flex-col items-start gap-4 rounded-xl border border-dashed border-line2 bg-bg3 p-7 sm:p-9">
        <div class="inline-flex items-center gap-2 rounded-full border border-line2 px-3 py-1 font-mono text-[9px] uppercase tracking-[0.16em] text-a1">
          Sin publicaciones
        </div>
        <h3 class="text-[clamp(18px,2.2vw,24px)] font-semibold tracking-[-0.02em] text-t1">
          Todavía no hay aplicaciones publicadas
        </h3>
        <p class="max-w-[620px] text-[14px] font-light leading-[1.75] text-t2">
          A medida que las vayamos terminando, cada una va a aparecer acá con su descripción y su estado.
        </p>
        <a
          href="/administrativas"
          class="mt-1 rounded-[10px] border border-line2 px-5 py-2.5 text-[13px] font-medium text-t1 transition hover:bg-line1"
        >
          Conocer el proyecto →
        </a>
      </div>
    )
  }

  {
    items.length > 0 && (
      <dialog
        data-apps-lightbox
        aria-label="Captura ampliada"
        class="m-auto w-[min(94vw,1180px)] max-w-none rounded-2xl border border-line1 bg-bg2 p-0 text-t1 shadow-[0_30px_80px_rgba(0,0,0,0.6)] backdrop:bg-black/80 backdrop:backdrop-blur-sm"
      >
        <div class="relative flex max-h-[88vh] flex-col">
          <button
            type="button"
            data-lightbox-close
            class="absolute right-3 top-3 z-[2] inline-flex h-9 w-9 items-center justify-center rounded-lg border border-white/15 bg-black/60 text-lg leading-none text-white/90 backdrop-blur transition hover:bg-black/80 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-a1"
            aria-label="Cerrar"
          >
            ×
          </button>

          <div class="relative flex min-h-0 items-center justify-center bg-bg p-3 sm:p-4">
            <img data-lightbox-img alt="" class="max-h-[76vh] w-auto max-w-full object-contain" />

            <button
              type="button"
              data-lightbox-prev
              aria-label="Captura anterior"
              class="group absolute inset-y-0 left-0 z-[1] flex w-1/2 items-center justify-start p-2 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[-4px] focus-visible:outline-a1 sm:w-1/3 sm:p-3"
            >
              <span
                class="pointer-events-none flex h-10 w-10 items-center justify-center rounded-full border border-white/15 bg-black/55 text-xl leading-none text-white/90 opacity-70 backdrop-blur transition group-hover:bg-black/80 group-hover:opacity-100 sm:opacity-0"
              >
                ‹
              </span>
            </button>

            <button
              type="button"
              data-lightbox-next
              aria-label="Captura siguiente"
              class="group absolute inset-y-0 right-0 z-[1] flex w-1/2 items-center justify-end p-2 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[-4px] focus-visible:outline-a1 sm:w-1/3 sm:p-3"
            >
              <span
                class="pointer-events-none flex h-10 w-10 items-center justify-center rounded-full border border-white/15 bg-black/55 text-xl leading-none text-white/90 opacity-70 backdrop-blur transition group-hover:bg-black/80 group-hover:opacity-100 sm:opacity-0"
              >
                ›
              </span>
            </button>
          </div>

          <div class="flex items-center justify-between gap-3 border-t border-line1 px-4 py-3">
            <p data-lightbox-caption class="text-[12px] font-medium text-t2"></p>
            <div class="flex shrink-0 items-center gap-3">
              <span
                data-lightbox-counter
                class="font-mono text-[10px] tracking-[0.14em] text-t3"
                aria-live="polite"></span>
              <span class="hidden font-mono text-[9px] uppercase tracking-[0.14em] text-t3 sm:block">
                ← → · Esc
              </span>
            </div>
          </div>
        </div>
      </dialog>
    )
  }
</Section>

<script>
  // Las capturas se abren en una modal (nativo <dialog>) con su propia galería:
  // botones, flechas del teclado y toque en la mitad izquierda/derecha.
  const setupLightbox = () => {
    // Con el ClientRouter la página se vuelve a montar: limpiamos el bloqueo de
    // scroll y no volvemos a enganchar los listeners.
    document.documentElement.style.overflow = "";
    if (document.documentElement.dataset.appsLightboxReady === "1") return;
    document.documentElement.dataset.appsLightboxReady = "1";

    const getDialog = () =>
      document.querySelector<HTMLDialogElement>("dialog[data-apps-lightbox]");

    let group: HTMLButtonElement[] = [];
    let index = 0;

    const render = (nextIndex: number) => {
      const dialog = getDialog();
      if (!dialog || group.length === 0) return;

      index = (nextIndex + group.length) % group.length;
      const trigger = group[index];
      const img = dialog.querySelector<HTMLImageElement>("[data-lightbox-img]");
      const caption = dialog.querySelector<HTMLElement>("[data-lightbox-caption]");
      const counter = dialog.querySelector<HTMLElement>("[data-lightbox-counter]");
      const previous = dialog.querySelector<HTMLElement>("[data-lightbox-prev]");
      const next = dialog.querySelector<HTMLElement>("[data-lightbox-next]");

      if (img) {
        img.src = trigger.dataset.lightboxSrc ?? "";
        img.alt = trigger.dataset.lightboxAlt ?? "";
      }
      if (caption) caption.textContent = trigger.dataset.lightboxCaption ?? "";
      if (counter) counter.textContent = `${index + 1} / ${group.length}`;

      const single = group.length <= 1;
      if (previous) previous.style.display = single ? "none" : "";
      if (next) next.style.display = single ? "none" : "";

      // Deja lista la próxima captura para que el cambio no parpadee.
      const ahead = group[(index + 1) % group.length];
      if (group.length > 1 && ahead?.dataset.lightboxSrc) {
        new Image().src = ahead.dataset.lightboxSrc;
      }
    };

    const open = (trigger: HTMLButtonElement) => {
      const dialog = getDialog();
      if (!dialog) return;

      const groupId = trigger.dataset.lightboxGroup ?? "";
      group = [...document.querySelectorAll<HTMLButtonElement>("[data-lightbox]")].filter(
        (item) => (item.dataset.lightboxGroup ?? "") === groupId,
      );
      index = Math.max(0, group.indexOf(trigger));
      render(index);

      if (!dialog.open) {
        dialog.showModal();
        document.documentElement.style.overflow = "hidden";
        dialog.addEventListener(
          "close",
          () => {
            document.documentElement.style.overflow = "";
          },
          { once: true },
        );
      }
    };

    document.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;

      if (target.closest("[data-lightbox-close]")) {
        getDialog()?.close();
        return;
      }

      if (target.closest("[data-lightbox-prev]")) {
        render(index - 1);
        return;
      }

      if (target.closest("[data-lightbox-next]")) {
        render(index + 1);
        return;
      }

      const trigger = target.closest<HTMLButtonElement>("[data-lightbox]");
      if (trigger) {
        open(trigger);
        return;
      }

      // Clic en el fondo oscuro (el ::backdrop no es un elemento: el evento
      // llega con el <dialog> como target).
      const dialog = getDialog();
      if (dialog?.open && target === dialog) dialog.close();
    });

    document.addEventListener("keydown", (event) => {
      const dialog = getDialog();
      if (!dialog?.open) return;

      if (event.key === "ArrowLeft") {
        event.preventDefault();
        render(index - 1);
      } else if (event.key === "ArrowRight") {
        event.preventDefault();
        render(index + 1);
      }
    });
  };

  setupLightbox();
</script>
