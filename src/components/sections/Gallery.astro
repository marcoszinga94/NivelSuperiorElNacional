---
import Section from "../Section.astro";
import SectionHeader from "../SectionHeader.astro";

const items = [
  { type: "img", src: "Nuetras carreras.png", icon: "🎓", alt: "Nuestras carreras — El Nacional UPC", label: "Nuestras carreras — El Nacional · UPC" },
  { type: "img", src: "ChatGPT Image 1 jun 2026, 11_17_35 a.m..png", icon: "🚀", alt: "Muestra Institucional 2026", label: "Muestra Institucional 2026" },
  { type: "img", src: "ChatGPT Image 1 jun 2026, 15_23_10.png", icon: "💻", alt: "Desarrollo de Software", label: "Desarrollo de Software" },
  { type: "img", src: "ChatGPT Image 2 jun 2026, 09_19_40 p.m..png", icon: "⭐", alt: "Astrónomos por un día", label: "Astrónomos por un día" },
  { type: "video", src: "SISTEMA.mp4", icon: "🎬", alt: "Sistema — video institucional", label: "Sistema · Video institucional" },
];
---

<Section id="galeria" bg="bg">
  <SectionHeader
    eyebrow="Muestra Institucional 2026"
    sub="Un poco de lo que fue la jornada."
  >
    La <span class="text-gradient-2">experiencia</span> en imágenes
  </SectionHeader>

  <div class="grid grid-cols-2 gap-4 md:grid-cols-3">
    {
      items.map((it, i) => (
        <div class:list={["reveal", `reveal-d${i}`, "group relative aspect-video overflow-hidden rounded-xl border border-line1 bg-bg3"]}>
          <div class="absolute inset-0 flex flex-col items-center justify-center gap-2 text-t3">
            <div class="text-3xl">{it.icon}</div>
            <div class="font-mono text-[10px] uppercase tracking-[0.1em]">{it.alt}</div>
          </div>
          {it.type === "img" ? (
            <img
              class="relative z-[1] h-full w-full object-cover"
              src={it.src}
              alt={it.alt}
              loading="lazy"
              onerror="this.remove()"
            />
          ) : (
            <video
              class="relative z-[1] h-full w-full object-cover"
              src={it.src}
              muted
              loop
              autoplay
              onerror="this.remove()"
            />
          )}
          <div class="absolute inset-0 z-[2] flex items-end bg-[linear-gradient(to_top,rgba(7,9,15,.8)_0%,transparent_60%)] p-4 opacity-0 transition-opacity group-hover:opacity-100">
            <div class="text-[11px] font-medium text-t1">{it.label}</div>
          </div>
        </div>
      ))
    }
  </div>
</Section>
