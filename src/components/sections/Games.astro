---
import Section from "../Section.astro";
import { games } from "../../data/games";

const stats = [
  { value: String(games.length), label: "Juegos" },
  { value: String(games.length), label: "Estudiantes" },
  { value: "6", label: "Herramientas" },
];
---

<Section id="juegos" bg="bg">
  <div class="grid items-end gap-10 lg:grid-cols-[1.15fr_0.85fr]">
    <div>
      <div class="reveal flex items-center gap-2.5 font-mono text-xs uppercase tracking-[0.2em] text-a1">
        <span class="h-1.5 w-1.5 rounded-full bg-a1"></span>
        Estación 05 · Los juegos
      </div>

      <h1
        class="reveal reveal-d1 mt-6 max-w-[680px] text-4xl font-bold leading-[1.05] tracking-[-0.03em] text-t1 sm:text-5xl"
      >
        Ocho juegos<br /><span class="text-gradient">hechos en el aula</span>
      </h1>

      <p class="reveal reveal-d2 mt-6 max-w-[560px] text-lg font-light leading-relaxed text-t2">
        Cada juego lo pensó, lo programó y lo presentó un estudiante. Los probamos con los nenes de primer grado en la
        muestra y quedaron andando.
      </p>
    </div>

    <div class="reveal reveal-d3 flex gap-10 lg:justify-end">
      {
        stats.map((s) => (
          <div>
            <div class="font-mono text-3xl leading-none text-t1">{s.value}</div>
            <div class="mt-1.5 text-xs uppercase tracking-[0.08em] text-t3">{s.label}</div>
          </div>
        ))
      }
    </div>
  </div>

  <div class="mt-12 grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
    {
      games.map((g, i) => (
        <article
          class:list={["reveal reveal-seq", "group flex flex-col overflow-hidden rounded-2xl border border-line1 bg-bg2 transition duration-500 ease-[cubic-bezier(0.32,0.72,0,1)]  hover:border-a1/35 "]}
          style={`--reveal-i:${i}`}
        >
          <div class="relative aspect-video overflow-hidden">
            <div class="absolute inset-0 flex items-center justify-center p-6" style={`background:${g.gradient}`}>
              {g.logo ? (
                <div class="flex h-24 w-full items-center justify-center md:h-32 lg:h-28">
                  <img
                    src={g.logo}
                    alt={`Ícono del ejecutable de ${g.title}`}
                    loading="lazy"
                    decoding="async"
                    class="max-h-full max-w-full rounded-xl object-contain  transition-transform duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:scale-[1.04]"
                  />
                </div>
              ) : (
                <div class="z-[1] flex flex-col items-center gap-2.5">
                  <div class="text-[52px] ">{g.icon}</div>
                </div>
              )}
            </div>
          </div>

          <div class="flex flex-1 flex-col gap-4 p-5.5">
            <div class="text-balance text-lg font-bold leading-tight tracking-[-0.02em] text-t1">{g.title}</div>

            <div class="flex items-center gap-3">
              <div class="flex shrink-0 -space-x-2">
                <div
                  class="flex h-10 w-10 items-center justify-center rounded-full font-mono text-[11px] font-semibold text-white"
                  style={`background:${g.accent}`}
                >
                  {g.initials}
                </div>
                {g.coInitials && (
                  <div
                    class="flex h-10 w-10 items-center justify-center rounded-full font-mono text-[11px] font-semibold text-white ring-2 ring-bg2"
                    style={`background:${g.coAccent ?? g.accent}`}
                  >
                    {g.coInitials}
                  </div>
                )}
              </div>
              <div class="min-w-0">
                <div class="text-[13px] font-semibold leading-snug text-t1">{g.author}</div>
                <div class="truncate text-[11px] text-t3">{g.role}</div>
              </div>
            </div>

            <p class="text-[12px] leading-relaxed text-t2">{g.objective}</p>

            {g.quote && (
              <blockquote class="border-l-2 border-a1 py-0.5 pl-3 text-[12px] italic leading-relaxed text-t2">
                "{g.quote}"
              </blockquote>
            )}

            <div class="mt-auto flex flex-wrap items-center justify-between gap-2.5 border-t border-line1 pt-3.5">
              <div class="flex flex-wrap gap-1.5">
                {g.tech.map((t) => (
                  <span class="rounded border border-line1 bg-bg5 px-2 py-0.5 font-mono text-[9px] text-t3">{t}</span>
                ))}
              </div>
              {g.web ? (
                <a
                  href={`/jugar/${g.web}`}
                  class="rounded-lg border border-a1/30 bg-a1/15 px-3.5 py-1.5 text-[11px] font-semibold text-a1 transition duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:bg-a1/25 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-a1"
                >
                  ▶ Jugar online
                </a>
              ) : (
                g.exe && (
                  <a
                    href={`/Ejecutadores/${encodeURIComponent(g.exe)}`}
                    download
                    class="rounded-lg border border-line1 bg-bg4 px-3.5 py-1.5 text-[11px] font-medium text-t2 transition duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:border-a1/40 hover:text-t1 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-a1"
                  >
                    ⬇ Sólo Windows
                  </a>
                )
              )}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</Section>
