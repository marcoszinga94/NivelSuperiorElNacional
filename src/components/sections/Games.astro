---
import Section from "../Section.astro";
import { games } from "../../data/games";

const stats = [
  { value: String(games.length), label: "Juegos" },
  { value: String(games.length), label: "Estudiantes" },
  { value: "6", label: "Herramientas" },
];
---

<Section id="juegos" bg="bg">
  <div class="grid items-end gap-10 lg:grid-cols-[1.15fr_0.85fr]">
    <div>
      <div class="reveal flex items-center gap-2.5 font-mono text-xs uppercase tracking-[0.2em] text-a1">
        <span class="h-1.5 w-1.5 rounded-full bg-a1"></span>
        Estación 05 · Los juegos
      </div>

      <h1
        class="reveal reveal-d1 mt-6 max-w-[680px] text-4xl font-bold leading-[1.05] tracking-[-0.03em] text-t1 sm:text-5xl"
      >
        Ocho juegos<br /><span class="text-gradient">hechos en el aula</span>
      </h1>

      <p class="reveal reveal-d2 mt-6 max-w-[560px] text-lg font-light leading-relaxed text-t2">
        Cada juego lo pensó, lo programó y lo presentó un estudiante. Los probamos con los nenes de primer grado en la
        muestra y quedaron andando.
      </p>
    </div>

    <div class="reveal reveal-d3 grid grid-cols-3 gap-3">
      {
        stats.map((s) => (
          <div class="rounded-xl border border-line1 bg-bg3 px-4 py-5 text-center">
            <div class="font-mono text-3xl font-medium leading-none text-t1">{s.value}</div>
            <div class="mt-2 text-xs uppercase tracking-[0.08em] text-t3">{s.label}</div>
          </div>
        ))
      }
    </div>
  </div>

  <div class="reveal mt-10 flex flex-wrap items-center gap-2.5">
    <a
      href="#equipo"
      class="rounded-full border border-line2 px-4 py-2 text-sm text-t2 transition duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] hover:border-a1/40 hover:text-t1"
    >
      Los estudiantes
    </a>
    <a
      href="#tecnologias"
      class="rounded-full border border-line2 px-4 py-2 text-sm text-t2 transition duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] hover:border-a1/40 hover:text-t1"
    >
      Las herramientas
    </a>
    <span class="ml-auto font-mono text-[10px] uppercase tracking-[0.12em] text-t3">
      ▶ jugar online · ⬇ sólo windows
    </span>
  </div>

  <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {
      games.map((g, i) => (
        <article
          class:list={["reveal reveal-seq", "group flex flex-col overflow-hidden rounded-2xl border border-line1 bg-bg2 transition duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:-translate-y-1 hover:border-a1/35 hover:shadow-[0_16px_48px_rgba(0,0,0,.5),0_0_32px_rgba(79,127,255,.1)]"]}
          style={`--reveal-i:${i}`}
        >
          <div class="relative aspect-video overflow-hidden">
            <div class="absolute inset-0 flex items-center justify-center p-6" style={`background:${g.gradient}`}>
              {g.logo ? (
                <div class="flex h-24 w-full items-center justify-center md:h-32 lg:h-24">
                  <img
                    src={g.logo}
                    alt={`Ícono del ejecutable de ${g.title}`}
                    loading="lazy"
                    decoding="async"
                    class="max-h-full max-w-full rounded-xl object-contain drop-shadow-[0_8px_28px_rgba(0,0,0,.55)] transition-transform duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:scale-[1.04]"
                  />
                </div>
              ) : (
                <div class="z-[1] flex flex-col items-center gap-2.5">
                  <div class="text-[52px] [filter:drop-shadow(0_0_20px_rgba(79,127,255,.4))]">{g.icon}</div>
                </div>
              )}
            </div>
          </div>

          <div class="flex flex-1 flex-col gap-3 p-5.5">
            <div class="flex flex-wrap gap-1.5 lg:min-h-10">
              <span class="inline-flex items-center rounded border border-a1/20 bg-a1/10 px-2.5 py-0.5 font-mono text-[9px] font-medium uppercase tracking-[0.1em] text-a1">
                {g.category}
              </span>
              <span class="inline-flex items-center rounded border border-green/20 bg-green/8 px-2.5 py-0.5 font-mono text-[9px] font-medium uppercase tracking-[0.1em] text-green">
                1° Grado
              </span>
              {g.featuredBadge && (
                <span class="inline-flex items-center rounded border border-orange/25 bg-orange/8 px-2.5 py-0.5 font-mono text-[9px] font-medium uppercase tracking-[0.1em] text-orange">
                  {g.featuredBadge}
                </span>
              )}
              {g.weeks && (
                <span class="inline-flex items-center rounded border border-line1 bg-bg4 px-2.5 py-0.5 font-mono text-[9px] font-medium uppercase tracking-[0.1em] text-t3">
                  {g.weeks}
                </span>
              )}
            </div>

            <div class="flex flex-col gap-0.5">
              <div class="text-balance text-lg font-bold leading-tight tracking-[-0.02em] text-t1">{g.title}</div>
              <p class="text-[12px] text-t3">
                por <span class="font-medium text-a1/75">{g.author}</span>
              </p>
            </div>
            <div class="rounded-lg border border-line1 bg-bg3 px-3 py-2 text-[11px] leading-relaxed text-t2">
              {g.objective}
            </div>

            <div class="mt-auto flex flex-wrap items-center justify-between gap-2.5 border-t border-line1 pt-3.5">
              <div class="flex flex-wrap gap-1.5">
                {g.tech.map((t) => (
                  <span class="rounded border border-line1 bg-bg5 px-2 py-0.5 font-mono text-[9px] text-t3">{t}</span>
                ))}
              </div>
              {g.web ? (
                <a
                  href={`/jugar/${g.web}`}
                  class="rounded-lg border border-a1/30 bg-a1/15 px-3.5 py-1.5 text-[11px] font-semibold text-a1 transition duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:bg-a1/25 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-a1"
                >
                  ▶ Jugar online
                </a>
              ) : (
                g.exe && (
                  <a
                    href={`/Ejecutadores/${encodeURIComponent(g.exe)}`}
                    download
                    class="rounded-lg border border-line1 bg-bg4 px-3.5 py-1.5 text-[11px] font-medium text-t2 transition duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:border-a1/40 hover:text-t1 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-a1"
                  >
                    ⬇ Sólo Windows
                  </a>
                )
              )}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</Section>
