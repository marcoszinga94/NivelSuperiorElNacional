---
import Section from "../Section.astro";
import SectionHeader from "../SectionHeader.astro";
import { games } from "../../data/games";
---

<Section id="juegos" bg="bg">
  <SectionHeader
    eyebrow="Estación 05 · Nuestros juegos"
    sub="Ocho juegos, ocho estudiantes, cada uno con su estilo. Todos hechos desde cero y probados con los nenes de primer grado."
  >
    Los juegos que <span class="text-gradient-2">hicimos</span>
  </SectionHeader>

  <div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
    {
      games.map((g, i) => (
        <article
          class:list={["game-card reveal", `reveal-d${(i % 6) + 1}`, "group flex flex-col overflow-hidden rounded-[20px] border border-line1 bg-bg2 transition hover:-translate-y-1 hover:border-a1/35 hover:shadow-[0_16px_48px_rgba(0,0,0,.5),0_0_32px_rgba(79,127,255,.1)]"]}
        >
          <div
            class="relative aspect-video cursor-pointer overflow-hidden"
            data-demo={g.demo}
            data-title={g.title}
            data-dev={g.author}
          >
            <div class="absolute inset-0 flex items-center justify-center" style={`background:${g.gradient}`}>
              {g.demo && (
                <video
                  class="pointer-events-none absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-400 group-hover:opacity-100"
                  src={g.demo}
                  muted
                  loop
                  preload="none"
                />
              )}
              <div class="z-[1] flex flex-col items-center gap-2.5 transition-opacity duration-400 group-hover:opacity-0">
                <div class="text-[52px] [filter:drop-shadow(0_0_20px_rgba(79,127,255,.4))]">{g.icon}</div>
              </div>
            </div>
            <div
              class="absolute inset-0 z-[2] flex items-center justify-center bg-black/40 opacity-0 transition-opacity group-hover:opacity-100"
            >
              <div class="flex h-14 w-14 items-center justify-center rounded-full bg-a1/90 text-xl shadow-[0_0_32px_rgba(79,127,255,.5)] transition-transform group-hover:scale-110">
                ▶
              </div>
            </div>
          </div>

          <div class="flex flex-1 flex-col gap-3 p-5.5">
            <div class="flex flex-wrap gap-1.5">
              <span class="inline-flex items-center rounded border border-a1/20 bg-a1/10 px-2.5 py-0.5 font-mono text-[9px] font-medium uppercase tracking-[0.1em] text-a1">
                {g.category}
              </span>
              <span class="inline-flex items-center rounded border border-green/20 bg-green/8 px-2.5 py-0.5 font-mono text-[9px] font-medium uppercase tracking-[0.1em] text-green">
                1° Grado
              </span>
              {g.featuredBadge && (
                <span class="inline-flex items-center rounded border border-orange/25 bg-orange/8 px-2.5 py-0.5 font-mono text-[9px] font-medium uppercase tracking-[0.1em] text-orange">
                  {g.featuredBadge}
                </span>
              )}
              <span class="inline-flex items-center rounded border border-line1 bg-bg4 px-2.5 py-0.5 font-mono text-[9px] font-medium uppercase tracking-[0.1em] text-t3">
                {g.weeks}
              </span>
            </div>

            <div class="text-lg font-bold leading-tight tracking-[-0.02em] text-t1">{g.title}</div>
            <p class="text-[12px] text-t3">
              por <span class="font-medium text-a1/75">{g.author}</span>
            </p>
            <div class="rounded-lg border border-line1 bg-bg3 px-3 py-2 text-[11px] leading-relaxed text-t2">
              La idea: {g.objective}
            </div>

            <div class="mt-auto flex flex-wrap items-center justify-between gap-2.5 border-t border-line1 pt-3.5">
              <div class="flex flex-wrap gap-1.5">
                {g.tech.map((t) => (
                  <span class="rounded border border-line1 bg-bg5 px-2 py-0.5 font-mono text-[9px] text-t3">{t}</span>
                ))}
              </div>
              <button
                type="button"
                class="rounded-lg border border-ba bg-a1/10 px-3.5 py-1.5 text-[11px] font-medium text-a1 transition hover:bg-a1/20"
                data-demo={g.demo}
                data-title={g.title}
                data-dev={g.author}
              >
                ▶ Demo
              </button>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</Section>

<script>
  document.querySelectorAll(".game-card").forEach((card) => {
    const video = card.querySelector("video");
    if (!video) return;
    card.addEventListener("mouseenter", () => video.play().catch(() => {}));
    card.addEventListener("mouseleave", () => {
      video.pause();
      video.currentTime = 0;
    });
  });
</script>
