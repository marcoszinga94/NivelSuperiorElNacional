---
import Counter from "../react/Counter";
import { heroStats, site } from "../../data/site";
---

<section id="inicio" class="relative min-h-screen overflow-hidden">
  <div class="pointer-events-none absolute inset-0 grid-bg"></div>
  <div
    class="pointer-events-none absolute left-[-10%] top-[20%] h-[60%] w-1/2 bg-[radial-gradient(ellipse,rgba(79,127,255,.08)_0%,transparent_70%)] blur-[40px]"
  >
  </div>

  <div
    class="relative z-[1] mx-auto grid min-h-screen w-full max-w-[1120px] grid-cols-1 items-center gap-12 px-5 pt-[calc(60px+60px)] pb-20 text-center md:px-10 lg:grid-cols-2 lg:text-left"
  >
    <div class="relative z-[1] flex flex-col items-center gap-6 lg:items-start">
    <div
      class="reveal inline-flex items-center gap-2 self-center rounded-full border border-a1/20 bg-a1/7 px-4 py-1.5 font-mono text-[10px] uppercase tracking-[0.2em] text-a1/85 lg:self-start"
    >
      <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-a1"></span>
      Muestra Institucional 2026 · La Carlota, Córdoba
    </div>

    <h1 class="reveal reveal-d1 text-[clamp(32px,4.5vw,58px)] font-extrabold leading-[1.08] tracking-[-0.035em]">
      <span class="block text-white [text-shadow:0_0_60px_rgba(79,127,255,.2)]">Aprender a programar</span>
      <span class="block text-gradient [filter:drop-shadow(0_0_24px_rgba(79,127,255,.35))]"
        >haciendo juegos de verdad</span
      >
    </h1>

    <p class="reveal reveal-d2 max-w-[520px] text-[clamp(14px,1.5vw,17px)] font-light leading-[1.75] text-t2">
      Somos los estudiantes de <strong class="font-medium text-t1">Práctica Profesionalizante I y Programación II</strong
      > de la Escuela Superior El Nacional. Durante un cuatrimestre armamos ocho videojuegos de astronomía para los nenes de primer grado. Los
      probamos con ellos en la muestra y este es el resultado.
    </p>

    <div class="reveal reveal-d3 flex flex-wrap justify-center gap-3 lg:justify-start">
      <a
        href="/juegos"
        class="inline-flex items-center gap-2 rounded-[10px] bg-a1 px-7 py-3.5 text-sm font-semibold tracking-[0.02em] text-white shadow-[0_4px_20px_rgba(79,127,255,.35)] transition hover:-translate-y-0.5 hover:shadow-[0_8px_32px_rgba(79,127,255,.5)]"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polygon points="5,3 19,12 5,21"></polygon>
        </svg>
        Ver los juegos
      </a>
      <a
        href="/proyecto#proceso"
        class="inline-flex items-center gap-2 rounded-[10px] border border-line2 px-7 py-3.5 text-sm font-medium text-t1 transition hover:border-ba hover:bg-line1"
        >Cómo lo hicimos</a
      >
    </div>

    <div class="reveal reveal-d4 flex overflow-hidden rounded-xl border border-line1">
      {
        heroStats.map((s) => (
          <div class="flex flex-col gap-0.5 border-r border-line1 px-6 py-4 last:border-r-0">
            <div class="font-mono text-2xl font-medium leading-none text-t1">
              <Counter client:visible target={s.target} suffix={s.suffix} />
            </div>
            <div class="text-[10px] uppercase tracking-[0.08em] text-t3">{s.label}</div>
          </div>
        ))
      }
    </div>

    <div class="reveal reveal-d5 rotate-[-1.5deg] font-hand text-2xl text-a1/90">
      sí, lo hicimos nosotros 🙌
    </div>
  </div>

  <div class="relative z-[1]">
    <div
      class="reveal reveal-d2 relative overflow-hidden rounded-[20px] border border-a1/20 shadow-[0_0_0_1px_rgba(79,127,255,.06),0_32px_80px_rgba(0,0,0,.7)]"
    >
      <div
        class="pointer-events-none absolute inset-[-20px] z-[-1] bg-[radial-gradient(ellipse_at_50%_50%,rgba(79,127,255,.15),transparent_70%)] blur-[20px]"
      >
      </div>
      <iframe
        class="block aspect-video w-full border-0"
        src={site.youtube}
        loading="lazy"
        allowfullscreen
        allow="autoplay; encrypted-media; picture-in-picture"
        title="Astrónomos por un día — Video del proyecto"></iframe>
    </div>
    <div class="reveal reveal-d3 mt-3.5 flex items-center gap-2 font-mono text-[10px] tracking-[0.08em] text-t3">
      <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green shadow-[0_0_6px_var(--color-green)]"></span>
      {site.event} · {site.institution} · {site.location}
    </div>
    <div class="reveal reveal-d4 mt-2 text-right font-hand text-xl text-t2">
      — 2° año · Tecnicatura en Programación Full Stack
    </div>
  </div>
  </div>
</section>
