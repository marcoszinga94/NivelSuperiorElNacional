---
import Section from "../Section.astro";
import SectionHeader from "../SectionHeader.astro";
import Counter from "../react/Counter";
import { metrics } from "../../data/site";
---

<Section id="impacto" bg="bg" class="overflow-hidden">
  <div
    class="pointer-events-none absolute left-1/2 top-1/2 h-[300px] w-[600px] -translate-x-1/2 -translate-y-1/2 bg-[radial-gradient(ellipse,rgba(79,127,255,.07),transparent_70%)] blur-[30px]"
  >
  </div>

  <SectionHeader
    eyebrow="Resultados concretos"
    center
    sub="Los números de un cuatrimestre de trabajo."
  >
    El impacto <span class="text-gradient-2">en números</span>
  </SectionHeader>

  <div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-5">
    {
      metrics.map((m) => (
        <div class:list={["metric-card reveal", m.delay, "flex flex-col items-center gap-2 rounded-xl border border-line1 bg-bg3 p-6 text-center transition hover:border-a1/30"]}>
          <div class="text-2xl">{m.icon}</div>
          <div class="font-mono text-[clamp(26px,3vw,34px)] font-medium leading-none text-t1">
            <Counter client:visible target={m.target} suffix={m.suffix} />
          </div>
          <div class="whitespace-pre-line text-[10px] uppercase leading-snug tracking-[0.08em] text-t3">{m.label}</div>
        </div>
      ))
    }
  </div>
</Section>
