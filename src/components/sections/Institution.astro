---
import Section from "../Section.astro";
import Divider from "../Divider.astro";
import PlanModal from "../PlanModal.astro";
import { site } from "../../data/site";

const carreras = [
  {
    nombre: "Tecnicatura Superior en Desarrollo de Software",
    badge: "La carrera de esta muestra",
    texto:
      "Programación, bases de datos, desarrollo web, inteligencia artificial y videojuegos. Los juegos de este sitio salieron de las materias de segundo año.",
    meta: "3 años · presencial · título oficial",
    href: "/#carrera",
    plan: "/planes/plan-desarrollo-software.webp",
    planTitle: "Plan de estudios · Desarrollo de Software",
    destacada: true,
  },
  {
    nombre: "Tecnicatura Superior en Administración",
    badge: "También en el nivel superior",
    texto:
      "Formación en gestión, organización y administración de empresas, con título oficial de la Escuela Superior El Nacional.",
    meta: "2½ años · presencial · título oficial",
    href: "/#administracion",
    plan: "/planes/plan-administracion.webp",
    planTitle: "Plan de estudios · Administración",
    destacada: false,
  },
];
---

<Section id="institucion" bg="bg">
  <div class="grid items-stretch gap-14 lg:grid-cols-[1.05fr_0.95fr] lg:gap-20">
    <div>
      <h1
        class="reveal reveal-d1 max-w-[680px] text-4xl font-bold leading-[1.05] tracking-[-0.03em] text-t1 sm:text-5xl lg:text-6xl"
      >
        Escuela Superior<br /><span class="text-gradient">El Nacional</span>
      </h1>

      <p class="reveal reveal-d2 mt-6 max-w-[680px] text-lg font-light leading-relaxed text-t2">
        Nivel secundario y nivel superior en la misma escuela. En el nivel superior se dictan dos carreras:{" "}
        <strong class="font-medium text-t1">Tecnicatura Superior en Desarrollo de Software</strong> y{" "}
        <strong class="font-medium text-t1">Tecnicatura Superior en Administración</strong>.
      </p>

      <div class="reveal reveal-d3 mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
        <a
          href="/#carrera"
          class="inline-flex w-full items-center justify-center gap-2 whitespace-nowrap rounded-xl bg-a1 px-6 py-3.5 text-base font-semibold sm:w-auto text-white  transition duration-300 ease-[cubic-bezier(0.32,0.72,0,1)]  hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-a1 active:translate-y-px"
        >
          Conocé la carrera →
        </a>
        <a
          href="/#inscripcion"
          class="inline-flex w-full items-center justify-center gap-2 whitespace-nowrap rounded-xl border border-line2 px-6 py-3.5 text-base font-medium sm:w-auto text-t1 transition duration-300 ease-[cubic-bezier(0.32,0.72,0,1)]  hover:bg-bg3 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-a1 active:translate-y-px"
        >
          Contactate
        </a>
      </div>
    </div>

    <div class="reveal reveal-d2">
      <div class="relative overflow-hidden rounded-2xl border border-line1 bg-black">
        <video
          class="block aspect-video w-full object-contain"
          src={site.schoolVideo}
          poster={site.schoolVideoPoster}
          autoplay
          muted
          loop
          playsinline
          controls
          preload="metadata"
          aria-label="Video institucional de la Escuela Superior El Nacional"
        ></video>
      </div>

      <div class="mt-5 flex flex-wrap items-center justify-between gap-3 font-mono text-xs uppercase tracking-[0.12em] text-t3">
        <span>La Carlota · Córdoba</span>
        <span>Argentina</span>
      </div>
    </div>
  </div>

  <div class="mt-16">
    <Divider />
  </div>

  <div class="mt-12">
    <div class="reveal flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <div class="font-mono text-xs uppercase tracking-[0.2em] text-a1">Nivel superior</div>
        <h2 class="mt-3 text-2xl font-bold tracking-[-0.02em] text-t1 sm:text-3xl">
          Las dos tecnicaturas de la escuela
        </h2>
      </div>
      <p class="max-w-[320px] text-sm text-t3">Las dos con título oficial de la Escuela Superior El Nacional.</p>
    </div>

    <div class="mt-8 grid gap-4 md:grid-cols-2">
      {
        carreras.map((c, i) => (
          <div
            class:list={[
              "reveal",
              `reveal-d${i + 1}`,
              "group relative flex flex-col gap-4 rounded-2xl border p-7 transition duration-300 ease-[cubic-bezier(0.32,0.72,0,1)]",
              c.destacada
                ? "border-a1/40 bg-bg3 hover:border-a1/70"
                : "border-line1 bg-bg2 hover:border-line2",
            ]}
          >
            <div
              class:list={[
                "w-fit rounded-full px-2.5 py-1 font-mono text-xs uppercase tracking-[0.12em]",
                c.destacada ? "bg-a1/12 text-a1" : "bg-bg4 text-t3",
              ]}
            >
              {c.badge}
            </div>
            <h3 class="text-balance text-xl font-semibold tracking-[-0.01em] text-t1">
              <a
                href={c.href}
                class="after:absolute after:inset-0 after:z-0 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-a1"
              >
                {c.nombre}
              </a>
            </h3>
            <p class="text-sm leading-relaxed text-t2">{c.texto}</p>
            <div class="mt-auto flex flex-wrap items-center justify-between gap-3 pt-2">
              <span class="font-mono text-xs uppercase tracking-[0.1em] text-t3">{c.meta}</span>
              <button
                type="button"
                data-plan-src={c.plan}
                data-plan-title={c.planTitle}
                class="relative z-[1] flex items-center gap-1.5 rounded text-sm font-medium text-a1 transition-colors hover:text-a1/80 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-a1"
              >
                Ver plan de estudios
                <span class="transition-transform duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:translate-x-1">
                  →
                </span>
              </button>
            </div>
          </div>
        ))
      }
    </div>

    <PlanModal />
  </div>
</Section>
