---
import Section from "../Section.astro";
import SectionHeader from "../SectionHeader.astro";

const phases = [
  {
    icon: "📋",
    step: "Paso 1 · Investigar",
    title: "¿Para quién es el juego?",
    text: "Antes de programar averiguamos qué necesitan los nenes de primer grado y cómo aprenden. Entrevistamos docentes y definimos qué tenía que hacer el juego.",
    chips: ["Entrevistas", "Requisitos"],
  },
  {
    icon: "🎨",
    step: "Paso 2 · Diseñar",
    title: "Bocetos y mecánicas",
    text: "Dibujamos las pantallas, pensamos las mecánicas y elegimos colores para nenes de 6 años. Probamos los prototipos antes de escribir código.",
    chips: ["Wireframes", "Prototipos"],
  },
  {
    icon: "💻",
    step: "Paso 3 · Programar",
    title: "Manos al código",
    text: "Programamos con Python y Pygame: estado del juego, colisiones, audio, sprites y puntaje. Cada uno tomó sus propias decisiones de arquitectura.",
    chips: ["Python", "Pygame", "Git"],
  },
  {
    icon: "🧪",
    step: "Paso 4 · Probar",
    title: "Y que lo jueguen los nenes",
    text: "Probamos con usuarios reales y arreglamos los bugs que aparecieron. Lo que andaba en la compu no siempre funcionaba con un nene de 6 años adelante.",
    chips: ["Testing", "Ajustes"],
  },
];
---

<Section id="proceso" bg="bg">
  <SectionHeader
    eyebrow="Cómo lo hicimos"
    sub="Ningún juego salió de un día para el otro. Estos fueron los cuatro pasos que seguimos, con las dudas y las vueltas incluidas."
  >
    Del boceto al juego, <span class="text-gradient-2">en 4 pasos</span>
  </SectionHeader>

  <div class="grid gap-4 sm:grid-cols-2">
    {
      phases.map((p, i) => (
        <div class:list={["reveal", `reveal-d${i + 1}`, "flex gap-4 rounded-xl border border-line1 bg-bg3 p-6"]}>
          <div class="flex shrink-0 flex-col items-center gap-2">
            <div class="flex h-12 w-12 items-center justify-center rounded-full border-2 border-line2 bg-bg4 text-lg">
              {p.icon}
            </div>
            <div class="font-mono text-[10px] text-t3">{String(i + 1).padStart(2, "0")}</div>
          </div>
          <div>
            <div class="mb-1 font-mono text-[9px] uppercase tracking-[0.15em] text-a1">{p.step}</div>
            <div class="mb-2 text-[16px] font-semibold text-t1">{p.title}</div>
            <p class="mb-3 text-[13px] font-light leading-relaxed text-t2">{p.text}</p>
            <div class="flex flex-wrap gap-1.5">
              {p.chips.map((c) => (
                <span class="rounded-full border border-ba bg-ba2 px-3 py-1 text-[11px] text-a1">{c}</span>
              ))}
            </div>
          </div>
        </div>
      ))
    }
  </div>
</Section>
