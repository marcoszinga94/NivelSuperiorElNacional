---
import Section from "../Section.astro";
import { site } from "../../data/site";

const facts = [
  {
    icon: "🎯",
    label: "Por qué lo hicimos",
    html: "Queríamos acercar la astronomía de una forma que a los nenes les quedara: jugando, tocando y preguntando.",
  },
  {
    icon: "👶",
    label: "Para quién",
    html: "Para más de <strong class=\"font-medium text-t1\">100 nenes y nenas de primer grado</strong>, en un espacio pensado para su edad.",
  },
  {
    icon: "🤝",
    label: "Cómo nos organizamos",
    html: "Los estudiantes de <strong class=\"font-medium text-t1\">secundario y de la tecnicatura</strong> guiamos a los más chicos. Enseñando también aprendimos.",
  },
];

const stations = [
  { icon: "⭐", label: "Estación 1", title: "Estrellas y Planetas", text: "La diferencia entre estrellas y planetas, y los nombres del sistema solar." },
  { icon: "🌅", label: "Estación 2", title: "Día, Noche y Estaciones", text: "Experimentos para entender por qué hay día, noche y estaciones." },
  { icon: "🔭", label: "Estación 3", title: "Instrumentos de Observación", text: "Telescopios y binoculares: cómo mira el cielo un astrónomo." },
  { icon: "🌙", label: "Estación 4", title: "La Luna, Fases y Eclipses", text: "Modelos de las fases lunares y simulaciones de eclipses." },
];

const programa = [
  ["9:00", "Bienvenida"],
  ["9:30", "Estaciones 1 a 4"],
  ["11:00", "Estación 5: los juegos"],
  ["11:45", "Merienda y cierre"],
];
---

<Section id="proyecto" bg="bg2">
  <div class="grid items-center gap-12 lg:grid-cols-[1fr_1.05fr]">
    <div>
      <div class="reveal flex items-center gap-2.5 font-mono text-xs uppercase tracking-[0.2em] text-a1">
        <span class="h-1.5 w-1.5 rounded-full bg-a1"></span>
        El proyecto · Nivel Superior El Nacional
      </div>

      <h1
        class="reveal reveal-d1 mt-6 max-w-[680px] text-4xl font-bold leading-[1.05] tracking-[-0.03em] text-t1 sm:text-5xl"
      >
        Un día como <span class="text-gradient">Astrónomos</span>
      </h1>

      <p class="reveal reveal-d2 mt-6 max-w-[520px] text-lg font-light leading-relaxed text-t2">
        Los nenes de primer grado se convirtieron en astrónomos por un día y nosotros los guiamos por cinco estaciones.
      </p>

      <div class="reveal reveal-d3 mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
        <a
          href="/juegos"
          class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-xl bg-a1 px-6 py-3.5 text-base font-semibold text-white transition duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-a1 active:translate-y-px"
        >
          Jugá los juegos →
        </a>
        <a
          href="/proyecto#proceso"
          class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-xl border border-line2 px-6 py-3.5 text-base font-medium text-t1 transition duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] hover:bg-bg3 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-a1 active:translate-y-px"
        >
          Cómo lo hicimos
        </a>
      </div>
    </div>

    <div class="reveal reveal-d2">
      <div class="relative overflow-hidden rounded-2xl border border-line1 bg-black">
        <video
          class="block aspect-video w-full object-contain"
          src={site.projectVideo}
          poster={site.projectVideoPoster}
          autoplay
          muted
          loop
          playsinline
          controls
          preload="metadata"
          aria-label="Astrónomos por un día — Video del proyecto"
        ></video>
      </div>
      <div class="mt-3.5 flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.12em] text-t3">
        <span class="h-1.5 w-1.5 rounded-full bg-green"></span>
        El video del proyecto
      </div>
    </div>
  </div>

  <div class="reveal mt-14 mb-12 rounded-2xl border border-line1 bg-bg3 p-8 md:p-10">
    <p class="text-[15px] font-light leading-[1.9] text-t2 md:text-base">
      Arrancó con una pregunta simple: ¿y si los nenes de primer grado pudieran <em>vivir</em> la astronomía en vez de
      solo escuchar sobre ella? Armamos una jornada con estudiantes de secundaria y de la tecnicatura, donde{" "}
      <strong class="font-medium text-t1">más de 100 nenes de 6 y 7 años</strong> recorrieron cinco estaciones. En cada
      una había un estudiante grande que los acompañaba y jugaba con ellos. Los nenes no miraron desde afuera: fueron
      los protagonistas.
    </p>
  </div>

  <div class="grid gap-12 lg:grid-cols-2">
    <div class="flex flex-col gap-4">
      {
        facts.map((f, i) => (
          <div class:list={["reveal", `reveal-d${i}`, "flex items-start gap-3.5 rounded-xl border border-line1 bg-bg3 p-5"]}>
            <div class="mt-0.5 shrink-0 text-[22px]">{f.icon}</div>
            <div>
              <div class="mb-1 font-mono text-[9px] uppercase tracking-[0.14em] text-t3">{f.label}</div>
              <p class="text-[13px] leading-relaxed text-t2" set:html={f.html} />
            </div>
          </div>
        ))
      }
      <div class="paper-note mt-1 rotate-[-1.2deg] rounded-md p-5">
        <div class="mb-3 font-hand text-2xl leading-none">Nuestro plan de la mañana</div>
        <div class="flex flex-col gap-1.5">
          {
            programa.map(([hora, texto]) => (
              <div class="flex items-baseline gap-3 text-[13px]">
                <span class="w-14 shrink-0 font-mono text-[12px] font-medium opacity-70">{hora}</span>
                <span>{texto}</span>
              </div>
            ))
          }
        </div>
        <div class="mt-3 text-right font-hand text-lg opacity-70">...se cumplió casi todo 😅</div>
      </div>
    </div>

    <div class="reveal reveal-d2">
      <div class="mb-4 font-mono text-[9px] uppercase tracking-[0.18em] text-a1">Las 5 estaciones</div>
      <div class="flex flex-col gap-3">
        {
          stations.map((s) => (
            <div class="flex items-center gap-4 rounded-xl border border-line1 bg-bg3 p-4">
              <div class="text-xl">{s.icon}</div>
              <div>
                <div class="mb-0.5 font-mono text-[9px] uppercase tracking-[0.14em] text-t3">{s.label}</div>
                <div class="mb-1 text-[13px] font-semibold text-t1">{s.title}</div>
                <p class="text-[12px] leading-snug text-t2">{s.text}</p>
              </div>
            </div>
          ))
        }
        <div class="relative flex items-center gap-4 overflow-hidden rounded-xl border border-ba bg-a1/4 p-4">
          <div class="absolute inset-x-0 top-0 h-0.5 bg-[linear-gradient(90deg,var(--color-a1),var(--color-a2))]"></div>
          <div class="text-xl">🎮</div>
          <div>
            <div class="mb-0.5 font-mono text-[9px] uppercase tracking-[0.14em] text-a1">Estación 5 · Software</div>
            <div class="mb-1 text-[13px] font-semibold text-t1">Videojuegos y Recursos Digitales</div>
            <p class="text-[12px] leading-snug text-t2">
              Nuestros 8 videojuegos esperando a los nenes con las compus listas.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</Section>
