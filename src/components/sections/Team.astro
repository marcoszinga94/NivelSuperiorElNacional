---
import Section from "../Section.astro";
import BlockHeader from "../BlockHeader.astro";
import { games } from "../../data/games";

// Una ficha por estudiante, por si alguien firma más de un juego.
const estudiantes = games.filter((g, i, todos) => todos.findIndex((x) => x.author === g.author) === i);
---

<Section id="equipo" bg="bg2">
  <BlockHeader
    index="02"
    title={"Los <span class='text-gradient-2'>estudiantes</span>"}
    sub="Ocho estudiantes, ocho juegos. Cada uno lo pensó, lo programó y lo presentó por su cuenta."
  />

  <div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
    {
      estudiantes.map((g, i) => (
        <article class:list={["reveal", `reveal-d${(i % 6) + 1}`, "flex flex-col overflow-hidden rounded-2xl border border-line1 bg-bg3"]}>
          <div class="flex items-center gap-4 border-b border-line1 p-5">
            <div
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full font-mono text-base font-semibold text-white"
              style={`background:${g.accent}`}
            >
              {g.initials}
            </div>
            <div class="min-w-0">
              <div class="truncate text-[14px] font-semibold text-t1">{g.author}</div>
              <div class="truncate text-[11px] text-a1/75">
                {g.icon} {g.title}
              </div>
              <span class="mt-1 inline-block rounded border border-line1 bg-bg4 px-2 py-0.5 font-mono text-[9px] text-t3">
                {g.role}
              </span>
            </div>
          </div>

          <div class="flex flex-1 flex-col gap-3 p-5">
            {g.studentDescription && (
              <p class="text-[12px] font-light leading-relaxed text-t2">{g.studentDescription}</p>
            )}
            {g.quote && (
              <div class="rounded-lg border-l-2 border-a1 bg-bg4 px-3.5 py-3 text-[12px] italic leading-relaxed text-t2">
                "{g.quote}"
              </div>
            )}
            <div class="mt-auto flex flex-wrap gap-1.5">
              {g.studentTech.map((t) => (
                <span class="rounded border border-line1 bg-bg5 px-2 py-0.5 font-mono text-[9px] text-t3">{t}</span>
              ))}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</Section>
