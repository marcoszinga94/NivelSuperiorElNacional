---
import { workshop } from "../../data/site";
---

<!-- Banda promocional del taller gratuito, justo debajo del hero de la home. -->
<section id="taller" class="relative overflow-hidden border-y border-a1/25 bg-bg2">
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_70%_130%_at_0%_50%,rgba(79,127,255,.16),transparent_60%),radial-gradient(ellipse_60%_130%_at_100%_50%,rgba(124,77,255,.14),transparent_60%)]"
  >
  </div>

  <div
    class="relative mx-auto flex max-w-[1120px] flex-col gap-6 px-5 py-8 md:flex-row md:items-center md:justify-between md:gap-10 md:px-10 md:py-9"
  >
    <div class="flex items-start gap-4">
      <span
        class="hidden h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-a1/30 bg-a1/10 font-mono text-lg font-semibold text-a1 sm:flex"
        aria-hidden="true">C#</span
      >

      <div>
        <div
          class="mb-2 inline-flex items-center gap-2 rounded-full border border-a1/30 bg-a1/10 px-3 py-1 font-mono text-[10px] uppercase tracking-[0.16em] text-a1"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-a1"></span>
          Taller gratuito
        </div>

        <h2
          class="text-balance text-[clamp(20px,2.6vw,28px)] font-bold leading-[1.15] tracking-[-0.02em] text-t1"
        >
          {workshop.title}
        </h2>

        <p class="mt-2 max-w-[620px] text-sm font-light leading-relaxed text-t2">
          {workshop.description}
        </p>
      </div>
    </div>

    <div class="flex shrink-0 flex-col items-start gap-2 md:items-end">
      <a
        href={workshop.form}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex w-full items-center justify-center gap-2 whitespace-nowrap rounded-xl bg-a1 px-6 py-3.5 text-sm font-semibold text-white transition duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-a1 active:translate-y-px md:w-auto"
      >
        Inscribite al taller →
        <span class="sr-only"> (se abre en una pestaña nueva)</span>
      </a>
      <span class="font-mono text-[10px] uppercase tracking-[0.12em] text-t3">
        Inscripción con formulario de Google
      </span>
    </div>
  </div>
</section>
