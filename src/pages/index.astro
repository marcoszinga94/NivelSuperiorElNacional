---
import Base from "../layouts/Base.astro";
import Institution from "../components/sections/Institution.astro";
import Career from "../components/sections/Career.astro";
import Enroll from "../components/sections/Enroll.astro";
import Administration from "../components/sections/Administration.astro";
import Divider from "../components/Divider.astro";
---

<Base>
  <Institution />
  <Divider />
  <Career />
  <Divider />
  <Administration />
  <Divider />
  <Enroll />

  <section class="relative overflow-hidden bg-bg2 py-20">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_80%_60%_at_50%_100%,rgba(79,127,255,.08),transparent_70%)]"
    >
    </div>
    <div class="relative mx-auto flex max-w-[800px] flex-col items-center px-5 text-center md:px-10">
      <h2 class="reveal mb-4 text-[clamp(22px,3.4vw,36px)] font-bold leading-tight tracking-[-0.03em] text-t1">
        Formamos desarrolladores<br /><span class="text-gradient">que crean soluciones reales</span>
      </h2>
      <p class="reveal reveal-d1 mb-7 max-w-[560px] text-[14px] font-light leading-relaxed text-t2">
        Todo lo que ves en esta página lo hicimos nosotros, los estudiantes de Práctica Profesionalizante I y Programación
        II. Programar se aprende programando cosas de verdad.
      </p>
      <div class="reveal reveal-d2 flex flex-wrap justify-center gap-3">
        <a
          href="/#inscripcion"
          class="inline-flex items-center gap-2 rounded-[10px] bg-a1 px-7 py-3.5 text-sm font-semibold text-white  transition "
          >Quiero saber de la carrera →</a
        >
        <a
          href="/juegos"
          class="inline-flex items-center gap-2 rounded-[10px] border border-line2 px-7 py-3.5 text-sm font-medium text-t1 transition hover:bg-line1"
          >Conocé los juegos</a
        >
      </div>
    </div>
  </section>
</Base>
